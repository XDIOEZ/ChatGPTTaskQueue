{
  "manifest_version": 3,
  "name": "ChatGPT 自动对话队列",
  "short_name": "对话队列",
  "version": "0.49.70",
  "description": "Enter 和 Ctrl+Enter 直接发送；仅通过插件界面按钮手动加入队列。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1:43578/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["agent-policy.js", "load-recovery.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "管理 ChatGPT 自动对话队列",
    "default_popup": "dashboard.html"
  }
}
