{
  "manifest_version": 3,
  "name": "ChatGPT 自动对话队列",
  "short_name": "对话队列",
  "version": "0.49.59",
  "description": "自动对话队列：普通任务结束后释放自建后台标签，协作团队验收后安全释放成员聊天窗口。",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*", "http://127.0.0.1:43578/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["load-recovery.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "管理 ChatGPT 自动对话队列",
    "default_popup": "dashboard.html"
  }
}
